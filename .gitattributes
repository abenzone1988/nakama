# 设置默认行为，所有文件的文本自动规范化
* text=auto eol=lf

# 明确声明应该始终规范化并在检出时转换为本机行结束符的文本文件
*.txt text eol=lf
*.js text
*.json text eol=lf
*.html text
*.css text
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text
*.go text eol=lf
*.py text
*.java text
*.c text
*.h text
*.cpp text
*.hpp text
*.sql text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Protobuf生成的文件
*.pb.go -text
*.pb.gw.go -text

# 特殊处理 dist 目录下的文件
console/ui/dist/** -text
console/ui/dist/**/*.* -text

# 声明二进制文件，不应修改其行结束符
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# 特殊文件处理
.gitignore text eol=lf
.gitattributes text eol=lf