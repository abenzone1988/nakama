NAKAMA_IMAGE=docker.sparkinfi.com/nakama/fruit:latest
POSTGRES_IMAGE=docker.sparkinfi.com/nakama/fruit-postgres:16-alpine
NGINX_IMAGE=docker.sparkinfi.com/nakama/fruit-nginx:stable-alpine
CERTBOT_IMAGE=docker.sparkinfi.com/nakama/fruit-certbot:latest
# Run prepare.sh to create .env with independent random values.
POSTGRES_PASSWORD=
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=
SESSION_ENCRYPTION_KEY=
SESSION_REFRESH_ENCRYPTION_KEY=
CONSOLE_SIGNING_KEY=
# Keep aligned with the game's client configuration.
SOCKET_SERVER_KEY=sparkgame
# Optional account contact email; automatic renewal does not depend on email.
LETSENCRYPT_EMAIL=
